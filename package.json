{
  "name": "@harborclient/plugin-dotenv",
  "type": "module",
  "scripts": {
    "release": "bash scripts/publish.sh",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "pack": "pnpm build && zip -r dotenv.hcp manifest.json README.md dist",
    "plugin:sign": "node --experimental-strip-types scripts/plugin-sign.ts",
    "plugin:verify": "node --experimental-strip-types scripts/plugin-verify.ts"
  },
  "dependencies": {
    "@harborclient/sdk": "^1.0.33",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "eslint": "^9.39.4",
    "prettier": "^3.9.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
